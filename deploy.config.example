# Occupy Uranus - Deployment Configuration
#
# Copy this file to deploy.config and fill in your server details
# deploy.config is gitignored to keep credentials private
#

# Server hostname or IP address
DEPLOY_HOST="ethlovesuranus.space"

# SSH/SFTP username
DEPLOY_USER="u758383565"

# Remote path (absolute path on server)
DEPLOY_PATH="/home/u758383565/domains/ethlovesuranus.space/public_html/OccupyUranusGame_bot"

# Optional: SSH port (default: 22)
# DEPLOY_PORT=22

# Deployment method: rsync or sftp
# rsync is faster and more efficient, sftp is more compatible
DEPLOY_METHOD="rsync"

# Optional: SSH key path (for passwordless deployment)
# Uses project-local key by default: .ssh/deploy_key
DEPLOY_SSH_KEY=".ssh/deploy_key"
