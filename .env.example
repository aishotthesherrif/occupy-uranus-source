# Copy to .env (gitignored) for docker compose.

# Bot token from @BotFather. Use a separate dev bot locally.
# Set this locally; never commit a real bot token.
TELEGRAM_BOT_TOKEN=

# Random string Telegram sends back in X-Telegram-Bot-Api-Secret-Token.
# Empty disables the check (fine locally). Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# Host port for http://localhost:<port>/
URANUS_PORT=8080
